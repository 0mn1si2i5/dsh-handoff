{
  "name": "dsh-handoff",
  "version": "0.1.0",
  "description": "Save and load a compact, Git-tracked handoff for DeepSeek Harness sessions",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "pnpm test:unit && pnpm test:e2e && vitest run tests/package.spec.ts",
    "test:unit": "vitest run tests/config.spec.ts tests/redact.spec.ts tests/document.spec.ts tests/git.spec.ts tests/summarize.spec.ts tests/save.spec.ts tests/load.spec.ts tests/command.spec.ts",
    "test:e2e": "pnpm build && vitest run tests/loader.e2e.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && publint",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session-query": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.0.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1-rc.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.5-rc.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "0.0.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.0.1-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.0.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.0.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.0.1-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "0.0.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.0.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.0.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.0.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.0.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.0.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.2",
    "@types/node": "^24.0.0",
    "oxlint": "1.76.0",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
